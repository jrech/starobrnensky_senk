---
import "@fontsource/caudex/400.css";
import "@fontsource/caudex/700.css";
import "@fontsource-variable/manrope";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Starobrněnský Šenk | Obědové menu a pivo v Novém Lískovci",
  description = "Místní šenk v Brně–Novém Lískovci. Aktuální obědové menu, dobré pivo, poctivé jídlo, zahrádka a rumy z celého světa.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#12372d" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // Hide the reveal targets before first paint so they don't flash before site.ts animates them in; show them anyway if it never runs.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const motionRoot = document.documentElement;
        motionRoot.classList.add("motion-ready");
        setTimeout(() => {
          if (motionRoot.classList.contains("motion-started")) return;
          motionRoot.dataset.motionFallback = "true";
          motionRoot.classList.remove("motion-ready");
        }, 3000);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Přejít k obsahu</a>
    <slot />
  </body>
</html>
