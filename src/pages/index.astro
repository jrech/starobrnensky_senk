---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import ContactReservation from "../components/ContactReservation.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getSiteContent } from "../lib/site-content";
import { getOpeningStatus, getStatusBanner, parseDays } from "../lib/opening-status";
import { getLunchView, renderLunch } from "../lib/lunch";
import AllergenLegend from "../components/AllergenLegend.astro";
import StatusBanner from "../components/StatusBanner.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/hero-interior-enhanced.png";
import galleryHeroImage from "../assets/hero-senk.webp";
import rumImage from "../assets/rum-bottle.png";
import gardenImage from "../assets/zahradka-senk.webp";
import foodImage from "../assets/specialita-koleno.webp";
import burgerImage from "../assets/senkovni-burger.png";
import ribsImage from "../assets/bbq-zebra.png";

const content = await getSiteContent();
const specialtyImages = [foodImage, burgerImage, ribsImage];
const cardWidths = [400, 640, 960];
const schemaDays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: "Starobrněnský Šenk",
  url: Astro.site?.href,
  image: new URL("/og.jpg", Astro.site).href,
  telephone: content.phone,
  email: content.email,
  servesCuisine: "Česká kuchyně",
  priceRange: "$$",
  hasMenu: new URL("/listky", Astro.site).href,
  sameAs: [content.facebookUrl, content.instagramUrl].filter(Boolean),
  address: { "@type": "PostalAddress", streetAddress: "Plachty 512/2", postalCode: "634 00", addressLocality: "Brno–Nový Lískovec", addressCountry: "CZ" },
  openingHoursSpecification: content.hours.flatMap((row) => {
    const times = row.hours.match(/(\d{1,2}:\d{2})\s*[–—-]\s*(\d{1,2}:\d{2})/);
    if (!times) return [];
    return [{ "@type": "OpeningHoursSpecification", dayOfWeek: parseDays(row.days).map((day) => schemaDays[day]), opens: times[1], closes: times[2] === "00:00" ? "23:59" : times[2] }];
  }),
};
const heroStatus = getOpeningStatus(content.hours, content.operatingStatus);
const lunchView = getLunchView(content.lunch);
const phone = { label: content.phone, href: content.phoneHref };
---

<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
  <SiteHeader content={content} />

  <main id="main" class="homepage-flow" data-sanity-project={import.meta.env.PUBLIC_SANITY_PROJECT_ID} data-sanity-dataset={import.meta.env.PUBLIC_SANITY_DATASET || "production"}>
    <section class="hero" id="top" data-theme="dark">
      <div class="hero-media reveal-media" aria-hidden="true">
        <Image src={heroImage} alt="" widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-content shell">
        <p class="eyebrow hero-eyebrow">Brno · Nový Lískovec</p>
        <h1 class="hero-title motion-title">
          <span class="line"><span>Po práci</span></span>
          <span class="line"><span>na jedno.</span></span>
          <span class="line title-indent"><span>A něco k tomu.</span></span>
        </h1>
      </div>
      <div class:list={["hero-status", `is-${heroStatus.state}`]} data-hero-status data-hours={JSON.stringify(content.hours)} data-status-override={JSON.stringify(content.operatingStatus)} role="status" aria-live="polite">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="hero-status-copy">
          <span data-hero-status-message>{heroStatus.message}</span>
          <span class="hero-status-notice" data-hero-status-notice hidden={!heroStatus.notice}>{heroStatus.notice}</span>
        </span>
      </div>
    </section>

    <section class="lunch section" id="obedove-menu" data-theme="light" aria-labelledby="lunch-title">
      <div class="shell">
        <div class="section-intro split-intro">
          <div>
            <p class="eyebrow" data-lunch-eyebrow>{lunchView.eyebrow}</p>
            <h2 id="lunch-title" class="display motion-title"><span class="line"><span>Co je dnes</span></span><span class="line title-indent"><span>k obědu?</span></span></h2>
          </div>
          <div class="intro-copy">
            <p>Každý pracovní den vaříme poctivé obědy. Vyberte si den a stavte se — obědové menu podáváme do 14:00.</p>
            <p class="updated" data-lunch-updated>{lunchView.weekLabel}</p>
          </div>
        </div>

        <div class="lunch-body" id="dnesni-menu">
          <StatusBanner override={content.operatingStatus} initial={getStatusBanner(content.operatingStatus)} />
          <div data-lunch data-lunch-data={JSON.stringify(content.lunch)} data-phone={JSON.stringify(phone)} set:html={renderLunch(lunchView, phone)} />
        </div>
        <div class="lunch-footer">
          <p>Obědové menu podáváme v pracovní dny od 11:00 do 14:00.</p>
          <AllergenLegend />
        </div>
      </div>
    </section>

    <section class="rum-section section" id="rumy" data-theme="dark" aria-labelledby="rum-title">
      <div class="shell rum-heading">
        <p class="eyebrow">Rumy z celého světa</p>
        <h2 id="rum-title" class="display motion-title"><span class="line"><span>Ochutnejte rumy</span></span><span class="line title-indent"><span>z celého světa.</span></span></h2>
        <p class="rum-lead">Od lehkých karibských rumů po výrazné stařené lahve. Ptejte se obsluhy, rádi poradíme.</p>
      </div>
      <div class="rum-viewport" data-rum-viewport tabindex="0" role="region" aria-label="Výběr rumů. Karty lze posouvat vodorovně pomocí trackpadu, posuvníku nebo šipek na klávesnici.">
        <div class="rum-track" data-rum-track>
          {content.rums.map((rum, index) => (
            <article class="rum-card">
              <div class="rum-card-image">
                {rum.image ? <img src={rum.image} alt={`Rum ${rum.name}`} width="1536" height="1024" loading="lazy" style={`object-position:${20 + index * 18}% center`} /> : <Image src={rumImage} alt={`Rum ${rum.name}`} widths={cardWidths} sizes="(max-width: 760px) 80vw, 420px" format="webp" loading="lazy" style={`object-position:${20 + index * 18}% center`} />}
              </div>
              <div class="rum-meta">
                {rum.origin && <p>{rum.origin}</p>}
                <h3>{rum.name}</h3>
                {rum.note && <p>{rum.note}</p>}
              </div>
            </article>
          ))}
          <article class="rum-card rum-card-last">
            <div>
              <p class="eyebrow">Na baru je toho víc</p>
              <h3>Najdeme rum podle vaší chuti.</h3>
              <p>Sladší, sušší, kořenitý nebo jen něco dobrého po večeři.</p>
              <a class="button button-light" href="#kontakt">Stavte se ochutnat</a>
            </div>
          </article>
        </div>
      </div>
      <div class="rum-progress shell" aria-hidden="true">
        <span>Posuňte dál</span><div><i data-rum-progress></i></div><span>{String(content.rums.length).padStart(2, "0")}</span>
      </div>
    </section>

    <section class="gallery section" id="o-nas" data-theme="cream" aria-labelledby="gallery-title">
      <div class="shell gallery-header">
        <p class="eyebrow">O nás</p>
        <h2 id="gallery-title" class="display motion-title"><span class="line"><span>Známé místo.</span></span><span class="line title-indent"><span>Dobré chvíle.</span></span></h2>
        <p class="gallery-lead">Od sousedů pro sousedy. Šenk patří do rytmu Nového Lískovce: po práci na jedno, dobré jídlo a známé tváře.</p>
      </div>
      <div class="gallery-grid shell">
        <figure class="gallery-item gallery-wide reveal-media"><Image src={gardenImage} alt="Hosté při podvečerním posezení na zahrádce" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 66vw" format="webp" loading="lazy" /></figure>
        <figure class="gallery-item gallery-tall reveal-media"><Image src={galleryHeroImage} alt="Čerstvě načepované pivo na stole" widths={cardWidths} sizes="(max-width: 760px) 100vw, 33vw" format="webp" loading="lazy" /></figure>
        <figure class="gallery-item reveal-media"><Image src={foodImage} alt="Pečené vepřové koleno s přílohami" widths={cardWidths} sizes="(max-width: 760px) 100vw, 33vw" format="webp" loading="lazy" /></figure>
        <figure class="gallery-item reveal-media"><Image src={rumImage} alt="Výběr rumů ve skle na baru" widths={cardWidths} sizes="(max-width: 760px) 100vw, 33vw" format="webp" loading="lazy" /></figure>
      </div>
    </section>

    <section class="specialties section" id="speciality" data-theme="light" aria-labelledby="specialties-title">
      <div class="shell">
        <div class="section-intro split-intro">
          <div><p class="eyebrow">Když máte větší hlad</p><h2 id="specialties-title" class="display motion-title"><span class="line"><span>Šenkovní</span></span><span class="line title-indent"><span>speciality.</span></span></h2></div>
          <p class="intro-copy">Pár jistot, kvůli kterým stojí za to zůstat déle než na jedno.</p>
        </div>
        <div class="specialty-grid">
          {content.specialties.map((item, index) => (
            <article class="specialty-card">
              <div class="specialty-image reveal-media">{item.image ? <img src={item.image} alt={item.name} width="1536" height="1024" loading="lazy" style={`object-position:${38 + index * 17}% center`} /> : <Image src={specialtyImages[index] || foodImage} alt={item.name} widths={cardWidths} sizes="(max-width: 760px) 100vw, 33vw" format="webp" loading="lazy" style={`object-position:${38 + index * 17}% center`} />}</div>
              <div class="specialty-copy"><h3>{item.name}</h3>{item.note && <p>{item.note}</p>}{item.price && <strong>{item.price}</strong>}</div>
            </article>
          ))}
        </div>
        <a class="text-link future-link" href="/listky">Celý jídelní a nápojový lístek</a>
      </div>
    </section>

    <ContactReservation content={content} />
  </main>

  <Footer content={content} />

  <div class="mobile-actions" aria-label="Rychlé akce"><a href="#dnesni-menu">Dnešní menu</a><a href="/listky">Lístek</a><a href={`tel:${content.phoneHref}`}>Zavolat</a></div>

  <script>import "../scripts/site.ts";</script>
</BaseLayout>
