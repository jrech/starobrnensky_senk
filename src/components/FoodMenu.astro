---
import type { MenuCategory } from "../lib/menu-content";
import { Image } from "astro:assets";
import porkPhoto from "../../public/assets/specialita-koleno.webp";
import burgerPhoto from "../../public/assets/senkovni-burger.png";
interface Props { categories: MenuCategory[] }
const { categories } = Astro.props;
---

<section class="menu-page-section section food-editorial" id="jidlo" data-theme="cream" aria-labelledby="food-menu-title">
  <div class="shell">
    <div class="menu-page-intro">
      <h2 id="food-menu-title" class="display motion-title"><span class="line"><span>K pivu i</span></span><span class="line title-indent"><span>na pořádný hlad.</span></span></h2>
      <p>Váha masa je uvedená v syrovém stavu. Alergeny najdete u jednotlivých položek.</p>
    </div>
    <nav class="food-index" aria-label="Kategorie jídelního lístku">
      {categories.map((category, index) => <a href={`#jidlo-${index}`}><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{category.title}</a>)}
    </nav>
    <div class="food-composition">
      {categories.map((category, index) => <>
        <section class:list={["food-chapter", `food-chapter-${index}`, { "food-chapter-long": category.items.length >= 9 }]} id={`jidlo-${index}`} aria-labelledby={`food-category-${index}`}>
          <header class="food-chapter-heading">
            <span class="food-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="motion-title" id={`food-category-${index}`}><span class="line"><span>{category.title}</span></span></h3>
          </header>
          <ul class="food-items">
            {category.items.map((item) => <li>
              <div class="food-item-line"><strong>{item.name}</strong><span class="food-leader" aria-hidden="true"></span><b>{item.price}</b></div>
              {(item.amount || item.allergens) && <p class="food-item-detail">{item.amount && <span>{item.amount}</span>}{item.allergens && <span>Alergeny: {item.allergens}</span>}</p>}
            </li>)}
          </ul>
        </section>
        {index === 2 && <figure class="food-photo food-photo-wide"><div class="food-photo-frame reveal-media"><Image src={porkPhoto} alt="Pečené vepřové koleno s přílohami" widths={[400, 800, 1200]} sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1488px) 48vw, 688px" format="webp" loading="lazy" /></div></figure>}
        {index === 3 && <figure class="food-photo food-photo-detail"><div class="food-photo-frame reveal-media"><Image src={burgerPhoto} alt="Burger s hovězím masem" widths={[400, 800, 1200]} sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1488px) 32vw, 440px" format="webp" loading="lazy" /></div></figure>}
      </>)}
    </div>
  </div>
</section>

<style>
  .food-index { display: flex; flex-wrap: wrap; column-gap: var(--space-4); row-gap: var(--space-1); margin-bottom: var(--space-10); padding-block: var(--space-2); border-bottom: 1px solid rgba(9,36,29,.2); }
  .food-index a { display: inline-flex; align-items: baseline; gap: var(--space-1); padding-block: 8px; font-size: 16px; font-weight: 650; text-underline-offset: 6px; }
  .food-index a span, .food-number { color: var(--brick-600); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .food-index a:focus-visible { color: var(--brick-700); text-decoration: underline; }
  .food-composition { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-10) var(--space-8); align-items: start; }
  .food-chapter { grid-column: span 6; min-width: 0; scroll-margin-top: 168px; }
  .food-chapter-0 { grid-column: span 7; }
  .food-chapter-1 { grid-column: span 5; padding-top: var(--space-8); }
  .food-chapter-heading { display: flex; align-items: baseline; gap: var(--space-2); margin-bottom: var(--space-4); }
  .food-chapter h3 { margin: 0; font-family: var(--font-display); font-size: clamp(36px, 3.7vw, 60px); font-weight: 400; line-height: 1.14; letter-spacing: -.03em; }
  .food-number { flex-shrink: 0; }
  .food-items { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .food-items li { min-width: 0; }
  .food-item-line { display: flex; align-items: baseline; gap: var(--space-1); }
  .food-item-line strong { min-width: 0; font-family: var(--font-sans); font-size: 18px; font-weight: 650; line-height: 1.5; }
  .food-leader { flex: 1 0 16px; border-bottom: 1px dotted rgba(9,36,29,.3); }
  .food-item-line b { flex: 0 0 auto; margin-left: auto; color: var(--brick-700); font-family: var(--font-display); font-size: 24px; font-weight: 400; line-height: 1.2; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .food-item-detail { display: flex; flex-wrap: wrap; gap: 4px var(--space-2); margin: 4px 0 0; color: var(--forest-800); font-size: 14px; line-height: 1.5; }
  .food-chapter-long { grid-column: 1 / -1; }
  .food-chapter-long .food-items { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); }
  .food-chapter-long h3 { font-size: clamp(44px, 5vw, 80px); }
  .food-photo { grid-column: span 6; min-width: 0; margin: 0; }
  .food-photo-frame { overflow: hidden; aspect-ratio: 4 / 3; background: var(--cream-200); }
  .food-photo-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .food-photo-detail { grid-column: span 6; }
  .food-photo-detail .food-photo-frame { aspect-ratio: 4 / 3; }
  @media (hover: hover) and (pointer: fine) { .food-index a:hover { color: var(--brick-700); text-decoration: underline; } }
  @media (max-width: 1024px) {
    .food-composition { column-gap: var(--space-4); row-gap: var(--space-8); }
    .food-chapter-0, .food-chapter-1 { grid-column: span 6; }
    .food-chapter-1 { padding-top: var(--space-4); }
    .food-chapter-long .food-items { column-gap: var(--space-4); }
    .food-chapter h3 { font-size: 40px; }
    .food-chapter-long h3 { font-size: 56px; }
  }
  @media (max-width: 760px) {
    .food-index { flex-wrap: nowrap; overflow-x: auto; margin-bottom: var(--space-6); column-gap: var(--space-3); }
    .food-index a { flex-shrink: 0; }
    .food-composition { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .food-chapter, .food-photo { grid-column: 1; grid-row: auto; padding-top: 0; }
    .food-chapter h3 { font-size: clamp(34px, 9vw, 48px); }
    .food-chapter-long .food-items { grid-template-columns: minmax(0, 1fr); }
    .food-chapter-heading { margin-bottom: var(--space-3); gap: var(--space-1); }
    .food-item-line { gap: 8px; }
    .food-item-line b { font-size: 22px; }
    .food-leader { flex-basis: 8px; }
    .food-photo-frame { aspect-ratio: 4 / 3; }
  }
</style>
