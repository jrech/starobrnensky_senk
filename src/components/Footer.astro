---
import Icon from "./Icon.astro";
import type { SiteContent } from "../lib/site-content";

interface Props {
  content: SiteContent;
  menuPage?: boolean;
}

const { content, menuPage = false } = Astro.props;
---

<footer class="footer" data-theme="dark">
  <div class="shell footer-top">
    <p class="footer-signature motion-title"><span class="line"><span>Na jedno.</span></span><span class="line"><span><em>A klidně déle.</em></span></span></p>
    <div class="footer-links">
      <div><p>Najdete nás</p><a href={content.mapUrl} target="_blank" rel="noopener noreferrer">{content.address}</a></div>
      <div><p>Ozvěte se</p><a class="icon-link" href={`tel:${content.phoneHref}`}><Icon name="phone" />{content.phone}</a><a class="icon-link" href={`mailto:${content.email}`}><Icon name="email" />{content.email}</a></div>
      <div><p>Rychle k věci</p><a href={menuPage ? "/#obedove-menu" : "#obedove-menu"}>Obědové menu</a><a href={menuPage ? "#jidlo" : "/listky#jidlo"}>Jídelní lístek</a><a href={menuPage ? "#piti" : "/listky#piti"}>Nápojový lístek</a>{!menuPage && <a href="#rezervace">Rezervace</a>}</div>
      <div class="socials"><p>Sledujte nás</p><div><a class="social-icon" href={content.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><Icon name="facebook" label="Facebook" /></a><span class="social-icon" role="img" aria-label="Instagram – odkaz doplníme"><Icon name="instagram" label="Instagram" /></span></div></div>
    </div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Starobrněnský Šenk</span><span>IČ: 62080245</span><a class="footer-credit" href="https://www.jonasrech.com" target="_blank" rel="noopener noreferrer">Vytvořeno Jonas Rech</a></div>
</footer>
