---
import Icon from "./Icon.astro";
import type { SiteContent } from "../lib/site-content";

interface Props {
  content: SiteContent;
  menuPage?: boolean;
  /** Pages without their own reservation form send the CTA to the homepage one. */
  reservationHref?: string;
}

const { content, menuPage = false, reservationHref = "#rezervace" } = Astro.props;
const sectionHref = (id: string) => menuPage ? `/#${id}` : `#${id}`;
---

<header class="site-header" data-header>
  <div class="site-header-inner shell">
    <a class="brand" href={menuPage ? "/" : "#top"} aria-label="Starobrněnský Šenk – domů">
      <span class="brand-name">Starobrněnský Šenk</span>
    </a>
    <nav class="desktop-nav" aria-label="Hlavní navigace">
      <a class={!menuPage ? "nav-priority" : undefined} href={sectionHref("obedove-menu")}>Obědové menu</a>
      <a class={menuPage ? "nav-priority" : undefined} href="/listky">Jídelní lístek</a>
      <a href={sectionHref("kontakt")}>Kontakt</a>
    </nav>
    <a class="button button-small button-light header-cta" href={reservationHref}>Rezervovat</a>
    <button class="menu-toggle" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <nav aria-label="Mobilní navigace">
        <a href={menuPage ? "/#dnesni-menu" : "#dnesni-menu"}>Obědové menu</a>
        <a href="/listky">Jídelní a nápojový lístek</a>
        <a href={sectionHref("kontakt")}>Kontakt a rezervace</a>
      </nav>
      <div class="mobile-hours-block">
        <p class="mobile-label">Otevírací doba</p>
        <dl class="mobile-hours">{content.hours.map((row) => <div><dt>{row.days}</dt><dd>{row.hours}</dd></div>)}</dl>
      </div>
      <div class="mobile-contact" aria-label="Kontaktní údaje">
        <p class="mobile-label">Kontakt</p>
        <a class="mobile-contact-link" href={`tel:${content.phoneHref}`}><Icon name="phone" />{content.phone}</a>
        <a class="mobile-contact-link" href={content.mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="location" />Navigovat k nám</a>
        <a class="mobile-contact-link" href={`mailto:${content.email}`}><Icon name="email" />{content.email}</a>
        <div class="mobile-socials" aria-label="Sociální sítě">
          <a class="mobile-contact-link" href={content.facebookUrl} target="_blank" rel="noopener noreferrer"><Icon name="facebook" />Facebook</a>
          {content.instagramUrl && <a class="mobile-contact-link" href={content.instagramUrl} target="_blank" rel="noopener noreferrer"><Icon name="instagram" />Instagram</a>}
        </div>
      </div>
    </div>
  </div>
</header>
