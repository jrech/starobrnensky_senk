---
import Icon from "./Icon.astro";
import type { SiteContent } from "../lib/site-content";

interface Props {
  content: SiteContent;
  menuPage?: boolean;
  /** Pages without their own reservation form send the CTA to the homepage one. */
  reservationHref?: string;
}

const { content, menuPage = false, reservationHref = "#rezervace" } = Astro.props;
const sectionHref = (id: string) => menuPage ? `/#${id}` : `#${id}`;
---

<header class="site-header" data-header>
  <div class="site-header-inner shell">
    <a class="brand" href={menuPage ? "/" : "#top"} aria-label="Starobrněnský Šenk – domů">
      <span class="brand-name">Starobrněnský šenk</span>
      <span class="brand-place">Brno · Nový Lískovec</span>
    </a>
    <nav class="desktop-nav" aria-label="Hlavní navigace">
      <a class={!menuPage ? "nav-priority" : undefined} href={sectionHref("obedove-menu")}>Obědové menu</a>
      <a class={menuPage ? "nav-priority" : undefined} href="/listky">Jídlo &amp; pití</a>
      <a href={sectionHref("o-nas")}>O nás</a>
      <a href={sectionHref("kontakt")}>Kontakt</a>
    </nav>
    <a class="button header-cta" href={reservationHref}>Rezervovat stůl</a>
    <button class="menu-toggle" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <nav class="mobile-nav" aria-label="Mobilní navigace">
        <a href={menuPage ? "/#dnesni-menu" : "#dnesni-menu"}>Obědové menu</a>
        <a href="/listky">Jídlo a pití</a>
      </nav>
      <div class="mobile-info">
        <div>
          <p class="mobile-label">Otevírací doba</p>
          <dl class="mobile-hours">{content.hours.map((row) => <div><dt>{row.days}</dt><dd>{row.hours}</dd></div>)}</dl>
        </div>
        <div>
          <p class="mobile-label">Kontakt</p>
          <ul class="mobile-contact" aria-label="Kontaktní údaje">
            <li><a href={`tel:${content.phoneHref}`}>{content.phone}</a></li>
            <li><a href={`mailto:${content.email}`}>{content.email}</a></li>
            <li><a href={content.mapUrl} target="_blank" rel="noopener noreferrer">Navigovat k nám<Icon name="arrowRight" /></a></li>
            <li><a href={content.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook<Icon name="arrowRight" /></a></li>
            {content.instagramUrl && <li><a href={content.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram<Icon name="arrowRight" /></a></li>}
          </ul>
        </div>
      </div>
      <a class="mobile-cta" href={`tel:${content.phoneHref}`}><Icon name="phone" />Rezervovat stůl</a>
    </div>
  </div>
</header>
