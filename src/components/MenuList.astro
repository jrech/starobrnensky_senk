---
import type { MenuCategory } from "../lib/menu-content";

interface Props { categories: MenuCategory[]; idPrefix: string; tone?: "light" | "dark" }
const { categories, idPrefix, tone = "light" } = Astro.props;

// The same drink in several sizes (0,5 l / 0,3 l) becomes one row with a price per size.
const grouped = categories.map((category) => {
  const rows: Array<{ name: string; allergens?: string; variants: Array<{ amount?: string; price: string }> }> = [];
  for (const item of category.items) {
    const row = rows.find((candidate) => candidate.name === item.name);
    if (row) row.variants.push({ amount: item.amount, price: item.price });
    else rows.push({ name: item.name, allergens: item.allergens, variants: [{ amount: item.amount, price: item.price }] });
  }
  return { title: category.title, rows };
});
---

<div class:list={["menu-list", `menu-list-${tone}`]}>
  {grouped.map((category, index) => (
    <section class="menu-group" id={`${idPrefix}-${index}`} aria-labelledby={`${idPrefix}-title-${index}`}>
      <h3 id={`${idPrefix}-title-${index}`}>{category.title}</h3>
      <ul>
        {category.rows.map((row) => {
          const single = row.variants.length === 1 ? row.variants[0] : undefined;
          const meta = [single?.amount, row.allergens && `alergeny ${row.allergens}`].filter(Boolean).join(" · ");
          return (
            <li>
              <span class="menu-name">
                {row.name}
                {meta && <span class="menu-meta">{meta}</span>}
              </span>
              {single ? <b class="menu-price">{single.price}</b> : (
                <span class="menu-variants">{row.variants.map((variant) => <span><span class="menu-meta">{variant.amount}</span><b class="menu-price">{variant.price}</b></span>)}</span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .menu-list { columns: 3 300px; column-gap: var(--space-8); }
  .menu-group { break-inside: avoid; margin-bottom: var(--space-8); scroll-margin-top: 72px; }
  .menu-group h3 { margin: 0 0 var(--space-2); padding-bottom: 8px; border-bottom: 1px solid rgba(9,36,29,.28); color: var(--brick-700); font-family: var(--font-display); font-size: 28px; font-weight: 400; line-height: 1.15; }
  .menu-group ul { margin: 0; padding: 0; list-style: none; }
  .menu-group li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); align-items: baseline; padding: 14px 0; border-bottom: 1px solid rgba(9,36,29,.1); }
  .menu-group li:last-child { border-bottom: 0; }
  .menu-name { font-size: 16px; font-weight: 600; line-height: 1.35; }
  .menu-meta { display: block; margin-top: 4px; color: #5a625e; font-size: 14px; font-weight: 500; line-height: 1.35; }
  .menu-variants { display: grid; gap: 4px; }
  .menu-variants > span { display: flex; justify-content: flex-end; align-items: baseline; gap: 12px; }
  .menu-variants .menu-meta { margin: 0; white-space: nowrap; }
  .menu-price { color: var(--brick-700); font-size: 16px; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .menu-list-dark .menu-group h3 { color: var(--honey-300); border-bottom-color: rgba(251,247,239,.3); }
  .menu-list-dark .menu-group li { border-bottom-color: rgba(251,247,239,.12); }
  .menu-list-dark .menu-name { color: var(--cream-50); }
  .menu-list-dark .menu-meta { color: rgba(251,247,239,.74); }
  .menu-list-dark .menu-price { color: var(--honey-300); }
  @media (max-width: 760px) {
    .menu-group { margin-bottom: var(--space-6); }
    .menu-group h3 { font-size: 26px; }
    .menu-group li { padding: 12px 0; }
  }
</style>
