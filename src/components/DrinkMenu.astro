---
import type { MenuCategory } from "../lib/menu-content";
import MenuList from "./MenuList.astro";
interface Props { categories: MenuCategory[] }
const { categories } = Astro.props;
---

<section class="menu-page-section menu-drinks section" id="piti" data-theme="brown" aria-labelledby="drink-menu-title">
  <div class="shell">
    <div class="menu-page-intro">
      <h2 id="drink-menu-title" class="display motion-title"><span class="line"><span>Na žízeň</span></span><span class="line title-indent"><span>i na chuť.</span></span></h2>
      <p>Od čepovaného piva po rum, který si necháte doporučit přímo u baru.</p>
    </div>
    <MenuList categories={categories} idPrefix="piti" tone="dark" />
  </div>
</section>
